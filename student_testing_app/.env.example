# Skopíruj tento súbor ako ".env" a doplň si vlastné lokálne hodnoty.
# .env sa necommituje do gitu (obsahuje citlivé údaje).

# --- Postgres (lokálna DB v Docker kontajneri) ---
POSTGRES_USER=student_user
POSTGRES_PASSWORD=zmen_toto_heslo
POSTGRES_DB=student_db

# --- Flask backend ---
# Musí zodpovedať vyššie uvedeným POSTGRES_* hodnotám. Host "db" = názov služby v docker-compose.yml.
DATABASE_URL=postgresql://student_user:zmen_toto_heslo@db:5432/student_db
FLASK_SECRET_KEY=zmen_na_nahodny_retazec
ADMIN_TOKEN=zmen_na_tajny_admin_token
APP_ACCESS_CODE=zmen_pristupovy_kod
FRONTEND_BASE_URL=http://localhost:5000

# --- Bind mounty pre dáta Q-learning / POMDP algoritmov (lokálne priečinky) ---
Q_LEARNING_MOUNT=./q_learning_data:/app/data/q_learning
POMDP_MOUNT=./pomdp_data:/app/data/pomdp
